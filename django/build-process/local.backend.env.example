APP_ENVIRONMENT=Local
# Application configuration
DEBUG=True
SECRET_KEY=your_local_django_secret_key_at_least_50_chars_long

# Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TIMEOUT=30
BROKER_URL=redis://:@redis:6379/1
CELERY_RESULT_BACKEND=redis://:@redis:6379/1

# Database configuration for local/staging
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_local_password
DATABASE_HOST=postgres
DATABASE_PORT=5432

MEDIA_URL=/media/
staticRootLocation=/app/static_root

# Contact us emails
CONTACT_US_ADMIN=admin@example.com
